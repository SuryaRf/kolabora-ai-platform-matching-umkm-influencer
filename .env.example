# ============================================================================
# Kolabora — template environment DEVELOPMENT
# Cara pakai: cp .env.example .env  lalu isi nilainya.
# File .env jangan pernah di-commit (sudah di-gitignore).
# Untuk produksi/VPS pakai .env.production.example.
# ============================================================================

# --- Database ----------------------------------------------------------------
# Postgres gratis: Supabase/Neon.
# Supabase: pakai Connection Pooler (port 6543) + ?pgbouncer=true&connection_limit=1
# Postgres lokal (brew): postgresql://<user>@localhost:5432/kolabora_dev?schema=public
DATABASE_URL="postgresql://user:password@host:5432/kolabora?schema=public"

# --- NextAuth v5 --------------------------------------------------------------
# Hasil dari: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Wajib "true" bila aplikasi berjalan di belakang proxy (Caddy/nginx/Vercel).
AUTH_TRUST_HOST="true"

# --- AI DeepSeek (opsional) ---------------------------------------------------
# Tanpa kunci ini, seluruh fitur AI otomatis memakai perhitungan aturan.
# Kunci: https://platform.deepseek.com/api_keys  (format sk-...)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TIMEOUT_MS="40000"
DEEPSEEK_MAX_RETRIES="2"

# Batas pemakaian AI per akun (menahan penyalahgunaan kunci)
AI_RATE_LIMIT_PER_MIN="8"
AI_RATE_LIMIT_PER_HOUR="60"
AI_RATE_LIMIT_PER_DAY="200"

# Cetak jumlah token setiap panggilan AI ke log (1 = aktif)
AI_LOG_USAGE="0"

# --- Vercel Blob (opsional) ---------------------------------------------------
# Aktifkan Blob di dashboard Vercel lalu salin token-nya.
# Tanpa token, unggah gambar memakai input URL.
BLOB_READ_WRITE_TOKEN=""

# --- Supabase (opsional, hanya bila memakai storage Supabase) -----------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
