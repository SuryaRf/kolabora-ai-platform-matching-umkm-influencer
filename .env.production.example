# ============================================================================
# KOLABORA — template environment PRODUKSI (VPS / bare-metal)
# Cara pakai:  cp .env.production.example .env   lalu isi nilainya
# File .env Jangan pernah di-commit (sudah di-gitignore).
# ============================================================================

# --- Database ---------------------------------------------------------------
# PostgreSQL lokal di VPS (dibuat otomatis oleh scripts/deploy-vps.sh):
#   postgresql://kolabora:<kata-sandi-dari-.dbpass>@127.0.0.1:5432/kolabora?schema=public
# Supabase (perlu sslmode=require, lewat pooler pakai port 6543):
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://kolabora:GANTI_DENGAN_ISI_.dbpass@127.0.0.1:5432/kolabora?schema=public&connection_limit=10&connect_timeout=10"

# --- NextAuth v5 ------------------------------------------------------------
# AUTH_SECRET: hasil `openssl rand -base64 32`
# AUTH_URL & NEXT_PUBLIC_APP_URL: alamat publik yang dilihat browser pengguna.
# AUTH_TRUST_HOST wajib true di VPS karena aplikasi berada di belakang Caddy/nginx.
AUTH_SECRET="GANTI_DENGAN_HASIL_openssl_rand_base64_32"
AUTH_URL="https://kolabora.tech"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="https://kolabora.tech"

# --- AI DeepSeek (opsional) --------------------------------------------------
# Tanpa kunci ini, seluruh fitur AI tetap jalan memakai perhitungan aturan.
# Kunci: https://platform.deepseek.com/api_keys  (format sk-...)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_TIMEOUT_MS="40000"
DEEPSEEK_MAX_RETRIES="2"

# Batas pemakaian AI per akun (menahan penyalahgunaan kunci)
AI_RATE_LIMIT_PER_MIN="8"
AI_RATE_LIMIT_PER_HOUR="60"
AI_RATE_LIMIT_PER_DAY="200"

# Cetak jumlah token setiap panggilan AI ke log PM2 (1 = aktif)
AI_LOG_USAGE="0"

# --- Port internal Node (dipakai PM2 & Caddy) --------------------------------
PORT="3000"

# --- Vercel Blob (opsional) --------------------------------------------------
# Kosongkan bila tidak deploy ke Vercel: unggah gambar otomatis memakai input URL.
BLOB_READ_WRITE_TOKEN=""
