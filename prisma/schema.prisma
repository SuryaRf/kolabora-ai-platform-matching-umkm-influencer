// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  UMKM
  INFLUENCER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CollaborationStatus {
  PROPOSED
  NEGOTIATION
  AGREED
  ESCROW_HELD
  IN_PRODUCTION
  CONTENT_SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  FILE
  BRIEF
  SYSTEM
}

enum NotificationType {
  APPLICATION
  COLLABORATION
  MESSAGE
  REVIEW
  PAYMENT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          UserRole?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  
  umkmProfile      UMKMProfile?
  influencerProfile InfluencerProfile?
  
  campaigns        Campaign[]        @relation("CampaignOwner")
  applications     Application[]     @relation("Applicant")
  collaborations   Collaboration[]   @relation("CollaborationParticipants")
  sentMessages     Message[]         @relation("MessageSender")
  notifications    Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UMKMProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName String
  category     String
  description  String?  @db.Text
  location     String?
  website      String?
  logoUrl      String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model InfluencerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  displayName String
  category    String
  bio         String?  @db.Text
  location    String?
  
  followers   Int      @default(0)
  engagement  Float    @default(0)
  platforms   Json?
  niches      String[]
  
  rateMin     Int?
  rateMax     Int?
  
  portfolio   PortfolioItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PortfolioItem {
  id        String            @id @default(cuid())
  profileId String
  profile   InfluencerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  title     String
  imageUrl  String
  link      String?
  createdAt DateTime @default(now())
}

model Campaign {
  id          String         @id @default(cuid())
  ownerId     String
  owner       User           @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  title       String
  description String         @db.Text
  category    String
  budgetMin   Int
  budgetMax   Int
  location    String?
  requirements String?       @db.Text
  deliverables String?
  
  status      CampaignStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  
  applications Application[]
  collaborations Collaboration[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Application {
  id          String            @id @default(cuid())
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  applicantId String
  applicant   User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  
  proposal    String            @db.Text
  proposedRate Int?
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  @@unique([campaignId, applicantId])
}

model Collaboration {
  id          String              @id @default(cuid())
  
  campaignId  String?
  campaign    Campaign?           @relation(fields: [campaignId], references: [id])
  
  participants User[]             @relation("CollaborationParticipants")
  
  title       String
  brief       String              @db.Text
  budget      Int
  status      CollaborationStatus @default(PROPOSED)
  
  // Escrow mock
  escrowAmount Int?
  escrowStatus String?            // HELD, RELEASED, REFUNDED
  escrowHeldAt DateTime?
  escrowReleasedAt DateTime?
  
  // Timeline
  agreedAt    DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  completedAt DateTime?
  
  messages    Message[]
  reviews     ContentReview[]
  
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Message {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  
  senderId        String
  sender          User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  content         String        @db.Text
  type            MessageType   @default(TEXT)
  fileUrl         String?
  read            Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
}

model ContentReview {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  
  contentUrl      String
  caption         String?       @db.Text
  notes           String?       @db.Text
  
  status          String        @default("PENDING") // PENDING, APPROVED, REVISION_REQUESTED
  reviewNotes     String?       @db.Text
  
  submittedAt     DateTime      @default(now())
  reviewedAt      DateTime?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  
  createdAt DateTime         @default(now())
}
